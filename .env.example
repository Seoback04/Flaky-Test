# Flaky Test Detector - Environment Variables
# Copy this file to `.env` and adjust as needed.

# Logging level: DEBUG, INFO, WARNING, ERROR
FTD_LOG_LEVEL=INFO

# Default number of repeated runs (used by CLI if --runs is omitted)
FTD_DEFAULT_RUNS=10

# Default delay (seconds) between runs
FTD_DEFAULT_DELAY=0.0

# Default pytest target path
FTD_DEFAULT_TESTS=demo

# Output directory
FTD_OUTPUT_DIR=outputs
